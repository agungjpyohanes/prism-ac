                  {(cfg.headers || []).map((_, colIdx) => {
                    const val = row[colIdx];
                    if (colIdx === cfg.i.status) {
                      const isDone = String(val).toLowerCase().includes('selesai') || String(val).toLowerCase().includes('done');
