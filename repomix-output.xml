<file path="src/index.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  /* DARK COSMIC MODE */
  html.dark body {
    @apply bg-[#050716] text-slate-100 antialiased selection:bg-cyan-400 selection:text-black min-h-screen font-sans;
    background: radial-gradient(circle at 50% 5%, #1e1b4b 0%, #0d1533 30%, #050716 80%),
                radial-gradient(circle at 90% 85%, rgba(168, 85, 247, 0.22) 0%, transparent 45%),
                radial-gradient(circle at 10% 90%, rgba(6, 182, 212, 0.18) 0%, transparent 45%),
                #050716;
    background-attachment: fixed;
  }

  /* LIGHT AURORA MODE */
  html.light body {
    @apply bg-[#eef2f9] text-slate-800 antialiased selection:bg-cyan-500 selection:text-white min-h-screen font-sans;
    background: radial-gradient(circle at 50% 5%, #e0e7ff 0%, #eef2f9 40%, #f8fafc 80%),
                radial-gradient(circle at 90% 85%, rgba(192, 132, 252, 0.25) 0%, transparent 45%),
                radial-gradient(circle at 10% 90%, rgba(34, 211, 238, 0.2) 0%, transparent 45%),
                #eef2f9;
    background-attachment: fixed;
  }
}

/* Glassmorphism Cards & Modals */
.card, .modal-panel {
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
  border-radius: 1.5rem !important;
  transition: all 0.3s ease-in-out !important;
}

html.dark .card, html.dark .modal-panel {
